{
    "name": "manishbisht.github.io",
    "private": true,
    "version": "2.0.0",
    "type": "module",
    "scripts": {
        "preinstall": "node -e \"if(!/yarn/.test(process.env.npm_execpath||'')){console.error('\\n\\u2716  This project uses yarn. Please run: yarn install\\n');process.exit(1)}\"",
        "dev": "vite",
        "build": "node scripts/build-static-pages.mjs && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "build:static": "node scripts/build-static-pages.mjs"
    },
    "engines": {
        "node": "26.x",
        "npm": "please-use-yarn",
        "yarn": "1.x"
    },
    "dependencies": {
        "@microsoft/clarity": "^1.0.2",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-router-dom": "^7.15.1"
    },
    "devDependencies": {
        "@eslint/js": "^9",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@vitejs/plugin-react": "^6.0.2",
        "eslint": "^9",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.8.3",
        "vite": "^8.0.13",
        "vitest": "^5.0.0"
    }
}
